[Unit]
Description=JRA race-day automation runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/keiba-prediction-jvn
EnvironmentFile=%h/projects/keiba-prediction-jvn/data/env/race-day.env
ExecStart=/usr/bin/python3 scripts/mini_raceday/race_day_runner.py --notify-discord --lock-file %h/projects/keiba-prediction-jvn/data/locks/race_day_runner.lock
Restart=on-failure
RestartSec=60
